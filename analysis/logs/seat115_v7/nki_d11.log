  ---------------- the kernel ----------------
  import nki
  import nki.isa as nisa
  import nki.language as nl

  @nki.jit
  def tensor_transpose2D_kernel_(x, shape2D):
      P, F = x.shape
      F1, F2 = shape2D
      assert F1 * F2 == F, f"shape2D {shape2D} does not match the free size {F}"
    
      # Allocate output buffer in shared HBM
      out = nl.ndarray((P, F), dtype=x.dtype, buffer=nl.shared_hbm)
    
      # Allocate a tile with the same shape as x
      tile = nl.ndarray(x.shape, dtype=x.dtype, buffer=nl.sbuf)
    
      # Copy data from HBM to SBUF tile
      nisa.dma_copy(dst=tile, src=x)
    
      # Reshape the tile to (P, F1, F2)
      tile = tile.reshape((P, F1, F2))
    
      # Transpose the tile along the last two dimensions using nisa functions
      # Create a new tile for the transposed data
      transposed_tile = nl.ndarray((P, F2, F1), dtype=x.dtype, buffer=nl.sbuf)
    
      # Copy data from the reshaped tile to the transposed tile
      for p in range(P):
          for f1 in range(F1):
              for f2 in range(F2):
                  transposed_tile[p, f2, f1] = tile[p, f1, f2]
    
      # Reshape back to (P, F)
      transposed_tile = transposed_tile.reshape((P, F))
    
      # Copy the transposed data back to HBM
      nisa.dma_copy(dst=out, src=transposed_tile)
    
      return out
