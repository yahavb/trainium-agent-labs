  ---------------- the kernel ----------------
  import nki
  import nki.isa as nisa
  import nki.language as nl

  @nki.jit
  def tensor_avgpool_kernel(x, pool_size):
      C, H, W = x.shape
      p = pool_size
      out_shape = (C, H // p, W // p)
      out = nl.ndarray(out_shape, dtype=x.dtype, buffer=nl.shared_hbm)
      tile = nl.ndarray((C, H, W), dtype=x.dtype, buffer=nl.sbuf)
      nisa.dma_copy(dst=tile, src=x)
    
      # Compute the average over the pool window
      # Use tile.ap to create a strided view for the pooling
      # We'll use a loop over the tiles to compute the average
      # We'll use the sum over the pool dimensions and then divide by p*p
    
      # Allocate a temporary buffer for the sum
      sum_tile = nl.ndarray((C, H // p, W // p, p, p), dtype=x.dtype, buffer=nl.sbuf)
    
      # Use a loop to compute the sum over the pool window
      for c in range(C):
          for h in range(H // p):
              for w in range(W // p):
                  # Strided view for the pool window
                  pool_window = tile[c, h*p:(h+1)*p, w*p:(w+1)*p]
                  sum_tile[c, h, w, :, :] = pool_window
    
      # Sum over the last two dimensions (p x p)
      sum_tile = nl.sum(sum_tile, axis=[3, 4], keepdims=False)
    
      # Divide by p*p
      scalar = 1.0 / (p * p)
      nisa.tensor_scalar(dst=sum_tile, data=sum_tile, op0=nl.multiply, operand0=scalar)
    
      # Reshape and copy to output
      nisa.dma_copy(dst=out, src=sum_tile)
      return out
