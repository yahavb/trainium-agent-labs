  ---------------- the kernel ----------------
  import nki
  import nki.isa as nisa
  import nki.language as nl

  @nki.jit
  def tensor_transpose2D_kernel_(x, shape2D):
      P, F = x.shape
      F1, F2 = shape2D
      assert F1 * F2 == F, f"shape2D {shape2D} does not match the free size {F}"
    
      # Allocate output buffer in shared HBM
      out = nl.ndarray((P, F), dtype=x.dtype, buffer=nl.shared_hbm)
    
      # Allocate tile with the same shape as x
      tile = nl.ndarray(x.shape, dtype=x.dtype, buffer=nl.sbuf)
    
      # Copy input data to tile
      nisa.dma_copy(dst=tile, src=x)
    
      # Loop over the partition dimension
      for p in nl.affine_range(P):
          # Extract the 2D slice from the tile
          # Reshape the tile to 2D
          tile_2d = nl.ndarray(shape2D, dtype=x.dtype, buffer=nl.sbuf)
          nisa.dma_copy(dst=tile_2d, src=tile[p])
        
          # Transpose the 2D tile
          # Create a transposed tile
          tile_transposed = nl.ndarray((F2, F1), dtype=x.dtype, buffer=nl.sbuf)
        
          # Correct transpose: use nl.transpose
          tile_transposed[:] = nl.transpose(tile_2d)
        
          # Copy the transposed data back to the output
          nisa.dma_copy(dst=out[p], src=tile_transposed)
    
      return out
