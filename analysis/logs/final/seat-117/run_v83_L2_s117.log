  ---------------- the kernel ----------------
  import nki
  import nki.isa as nisa
  import nki.language as nl

  @nki.jit
  def tensor_transpose2D_kernel_(x, shape2D):
      P, F = x.shape
      F1, F2 = shape2D
      assert F1 * F2 == F, f"shape2D {shape2D} does not match the free size {F}"

      # Allocate output tile in shared HBM
      out = nl.ndarray((P, F), dtype=x.dtype, buffer=nl.shared_hbm)

      # Allocate input tile in SBUF
      in_tile = nl.ndarray((P, F1, F2), dtype=x.dtype, buffer=nl.sbuf)

      # DMA copy input to SBUF
      nisa.dma_copy(dst=in_tile, src=x)

      # Reshape and transpose in SBUF
      # Transpose the last two dimensions
      transposed = nl.ndarray((P, F2, F1), dtype=x.dtype, buffer=nl.psum)

      # Loop over each row and transpose the F1 x F2 block
      for j in range(F1):
          for k in range(F2):
              nisa.tensor_copy(dst=transposed[:, k:k + 1, j:j + 1], src=in_tile[:, j, k])

      # Copy result from PSUM to SBUF
      nisa.tensor_copy(dst=in_tile, src=transposed)

      # DMA copy result from SBUF to output in shared HBM
      nisa.dma_copy(dst=out, src=in_tile)
      return out
