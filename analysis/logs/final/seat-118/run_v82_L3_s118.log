  ---------------- the kernel ----------------
  import nki
  import nki.isa as nisa
  import nki.language as nl

  @nki.jit
  def nki_matmul_basic_(lhsT, rhs):
      # Allocate SBUF tiles for lhsT and rhs
      lhs_tile = nl.ndarray(lhsT.shape, dtype=lhsT.dtype, buffer=nl.sbuf)
      rhs_tile = nl.ndarray(rhs.shape, dtype=rhs.dtype, buffer=nl.sbuf)
      result_tile = nl.ndarray((lhsT.shape[1], rhs.shape[1]), dtype=lhsT.dtype, buffer=nl.psum)

      # Copy lhsT and rhs into SBUF tiles
      nisa.dma_copy(dst=lhs_tile, src=lhsT)
      nisa.dma_copy(dst=rhs_tile, src=rhs)

      # Perform matrix multiplication using nc_matmul
      nisa.nc_matmul(dst=result_tile, stationary=lhs_tile, moving=rhs_tile)

      # Allocate a new SBUF tile for the result to copy from PSUM
      res_tile = nl.ndarray(result_tile.shape, dtype=result_tile.dtype, buffer=nl.sbuf)

      # Copy result from PSUM to SBUF
      nisa.tensor_copy(dst=res_tile, src=result_tile)

      # Allocate output tile in shared HBM
      out_tile = nl.ndarray((lhsT.shape[1], rhs.shape[1]), dtype=lhsT.dtype, buffer=nl.shared_hbm)

      # Copy from SBUF to shared HBM
      nisa.dma_copy(dst=out_tile, src=res_tile)

      return out_tile
