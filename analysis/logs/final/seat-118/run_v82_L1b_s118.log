  import nki
  import nki.isa as nisa
  import nki.language as nl

  @nki.jit
  def tensor_avgpool_kernel(x, pool_size):
      C, H, W = x.shape
      p = pool_size
      out_shape = (C, H // p, W // p)
      out = nl.ndarray(out_shape, dtype=x.dtype, buffer=nl.shared_hbm)
      tile = nl.ndarray((C, H, W), dtype=x.dtype, buffer=nl.sbuf)
      nisa.dma_copy(dst=tile, src=x)
    
      # Compute the average over the pooling window
      # Reshape to (C, H//p, p, W//p, p)
      # Then compute mean over the last two dimensions
      # We use tile views and nl.sum to compute the mean
    
      # Compute the sum over the pooling window
      # We use a strided view to get the windowed data
      # We need to handle the strided view correctly
      # For each channel, we process the H and W dimensions
    
      # First, compute the sum over the pooling window
      # We use a loop over the tiles
      # We assume that the tile can fit the entire input
      # We process each tile in the H and W dimensions
    
      # We need to compute the sum over the last two dimensions
      # So we reshape the tile to (C, H//p, p, W//p, p)
      # Then compute the mean over the last two dimensions
    
      # We can use nl.sum with the appropriate axes
      # But since we can't reshape directly, we use a strided view
    
      # We need to compute the sum over the last two dimensions
      # We can use a loop over the tiles in the H and W dimensions
      # We use the tile's partition axis for the channel dimension
    
      # We use the tile's partition axis for the channel dimension
      # We process the H and W dimensions with affine_range
    
      # Compute the sum over the pooling window
      # We use a strided view to get the windowed data
      # We need to loop over the tiles in the H and W dimensions
    
      # We process the H dimension
      for h in nl.affine_range(H // p):
          for w in nl.affine_range(W // p):
              # Strided view for the current window
              view = tile[:, h*p:(h+1)*p, w*p:(w+1)*p]
              # Compute the sum over the last two dimensions
              s = nl.sum(view, axis=[1, 2], keepdims=True)
              # Compute the mean by scaling by 1/(p*p)
              m = nl.ndarray((C, 1, 1), dtype=x.dtype, buffer=nl.sbuf)
              nisa.tensor_scalar(dst=m, data=s, op0=nl.multiply, operand0=1.0 / (p * p))
              # Copy the result to the output
              out[:, h, w] = m
      return out
