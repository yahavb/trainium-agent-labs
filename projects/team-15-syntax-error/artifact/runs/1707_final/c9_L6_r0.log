  ---------------- the kernel ----------------
  import nki
  import nki.isa as nisa
  import nki.language as nl

  @nki.jit
  def nki_matmul_block_free_dimension_(lhsT, rhs):
      K, M = lhsT.shape                         # left operand arrives TRANSPOSED: K is the partition dim
      _, N = rhs.shape
      result = nl.ndarray((M, N), dtype=lhsT.dtype, buffer=nl.shared_hbm)
      TM, TK, TN = 128, 128, 512                # hardware MAXIMA, not targets
      # Preload all tiles into SBUF once
      a = []  # a[k][m] = lhsT[k0:k0 + k_sz, m0:m0 + m_sz]
      b = []  # b[k][n] = rhs[k0:k0 + k_sz, n0:n0 + n_sz]
      for k in range((K + TK - 1) // TK):
          k0 = k * TK
          k_sz = min(TK, K - k0)
          a_k = []
          for m in range((M + TM - 1) // TM):
              m0 = m * TM
              m_sz = min(TM, M - m0)
              a_k.append(nl.ndarray((k_sz, m_sz), dtype=lhsT.dtype, buffer=nl.sbuf))
              nisa.dma_copy(dst=a_k[-1], src=lhsT[k0:k0 + k_sz, m0:m0 + m_sz])
          a.append(a_k)
      for k in range((K + TK - 1) // TK):
          k0 = k * TK
          k_sz = min(TK, K - k0)
          b_k = []
          for n in range((N + TN - 1) // TN):
              n0 = n * TN
              n_sz = min(TN, N - n0)
              b_k.append(nl.ndarray((k_sz, n_sz), dtype=rhs.dtype, buffer=nl.sbuf))
              nisa.dma_copy(dst=b_k[-1], src=rhs[k0:k0 + k_sz, n0:n0 + n_sz])
          b.append(b_k)
      # Perform matmul
      for m in range((M + TM - 1) // TM):
          m0 = m * TM
          m_sz = min(TM, M - m0)
          for n in range((N + TN - 1) // TN):
              n0 = n * TN
              n_sz = min(TN, N - n0)
              acc = nl.ndarray((m_sz, n_sz), dtype=nl.float32, buffer=nl.psum)
              for k in range((K + TK - 1) // TK):
                  k0 = k * TK
                  k_sz = min(TK, K - k0)
                  nisa.nc_matmul(dst=acc, stationary=a[k][m], moving=b[k][n])
              # Copy result to HBM
              out_tile = nl.ndarray((m_sz, n_sz), dtype=acc.dtype, buffer=nl.sbuf)
              nisa.tensor_copy(dst=out_tile, src=acc)
              nisa.dma_copy(dst=result[m0:m0 + m_sz, n0:n0 + n_sz], src=out_tile)
      return result
