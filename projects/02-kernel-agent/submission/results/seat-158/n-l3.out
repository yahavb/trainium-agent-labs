  ---------------- the kernel ----------------
  import nki
  import nki.isa as nisa
  import nki.language as nl

  @nki.jit
  def nki_matmul_basic_(lhsT, rhs):
      M = lhsT.shape[1]
      N = rhs.shape[1]
      K = lhsT.shape[0]
      tile_lhs = nl.ndarray((K, M), dtype=lhsT.dtype, buffer=nl.sbuf)
      tile_rhs = nl.ndarray((K, N), dtype=rhs.dtype, buffer=nl.sbuf)
      out = nl.ndarray((M, N), dtype=lhsT.dtype, buffer=nl.psum)
      nisa.dma_copy(dst=tile_lhs, src=lhsT)
      nisa.dma_copy(dst=tile_rhs, src=rhs)
      nisa.nc_matmul(dst=out, stationary=tile_lhs, moving=tile_rhs, is_stationary_onezero=False, is_moving_onezero=False, is_transpose=False, accumulate=None, tile_position=(), tile_size=(), perf_mode=nisa.matmul_perf_mode.none, name=None)
      return out
  -------------------------------------------

