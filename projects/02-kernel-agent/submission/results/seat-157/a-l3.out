  ---------------- the kernel ----------------
  import nki
  import nki.isa as nisa
  import nki.language as nl

  @nki.jit
  def nki_matmul_basic_(lhsT, rhs):
      # Allocate output buffer in shared HBM with correct shape
      out = nl.ndarray(shape=(64, 512), dtype=lhsT.dtype, buffer=nl.shared_hbm)
      # Allocate SBUF for lhsT and rhs tiles
      sbuf_lhs_tile = nl.ndarray(shape=(128, 64), dtype=nl.float32, buffer=nl.sbuf)
      sbuf_rhs_tile = nl.ndarray(shape=(128, 512), dtype=nl.float32, buffer=nl.sbuf)
      psum_tile = nl.ndarray(shape=(64, 512), dtype=nl.float32, buffer=nl.psum)
      # Allocate separate SBUF for psum_tile
      sbuf_psum_tile = nl.ndarray(shape=(64, 512), dtype=nl.float32, buffer=nl.sbuf)
    
      # Copy lhsT to SBUF
      nisa.dma_copy(dst=sbuf_lhs_tile, src=lhsT)
      # Copy rhs to SBUF
      nisa.dma_copy(dst=sbuf_rhs_tile[0:128, 0:512], src=rhs)
    
      # Perform matrix multiplication
      nisa.nc_matmul(dst=psum_tile, stationary=sbuf_lhs_tile, moving=sbuf_rhs_tile[0:128, 0:512])
    
      # Copy result from PSUM to separate SBUF
      nisa.tensor_copy(dst=sbuf_psum_tile, src=psum_tile)
    
      # Copy result from SBUF to shared HBM
      nisa.dma_copy(dst=out, src=sbuf_psum_tile)
      return out
  -------------------------------------------

